{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mantu-financial-assessment",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": false,
    "logs": {
      "enabled": false,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ATTEMPTS",
        "class_name": "Assessment"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Assessment"
      ]
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "109116420",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "vars": {
    "LIVE_ENABLED": "false",
    "DURATION_MINUTES": "15",
    "INVITE_TTL_MINUTES": "30"
  },
  "r2_buckets": [
    {
      "binding": "RECORDS",
      "bucket_name": "mantu-financial-assessment-records",
      "jurisdiction": "eu"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  }
}
