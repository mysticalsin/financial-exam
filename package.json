{
  "name": "mantu-financial-assessment",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "wrangler dev scripts/local-entry.js --local --ip 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "test:stress": "node --test --test-concurrency=1 tests/stress.test.js tests/random.test.js",
    "profile:hot-path": "node scripts/hot-path-profile.mjs",
    "test:integration": "node tests/integration.mjs",
    "test:candidate-ui": "node tests/candidate-ui.mjs",
    "test:practice-ui": "node tests/practice-ui.mjs",
    "build": "wrangler deploy --dry-run --outdir .build",
    "deploy": "wrangler deploy",
    "ops": "node scripts/ops.mjs",
    "test:reviewer": "node tests/reviewer-ui.mjs"
  },
  "dependencies": {
    "jose": "6.2.17"
  },
  "devDependencies": {
    "playwright": "1.65.0",
    "wrangler": "4.159.0"
  }
}
